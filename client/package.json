{
  "name": "madad-client",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "cap:add": "npx cap add android",
    "cap:assets": "npx @capacitor/assets generate --android --assetPath resources",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:run": "npm run build && npx cap run android",
    "cap:live": "npx cap run android --live-reload --external",
    "cap:apk": "npm run build && npx cap sync android && npm run gradle:debug",
    "cap:apk:release": "npm run build && npx cap sync android && npm run gradle:release",
    "gradle:debug": "cd android && (gradlew.bat assembleDebug || ./gradlew assembleDebug)",
    "gradle:release": "cd android && (gradlew.bat assembleRelease || ./gradlew assembleRelease)"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/geolocation": "^6.0.1",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/network": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "date-fns": "^3.6.0",
    "idb": "^8.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.400.0",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.24.0",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.3",
    "vite-plugin-pwa": "^0.20.0"
  }
}
