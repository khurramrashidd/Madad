# Where the client finds the API.
#
# Leave BLANK for:
#   * laptop development — the Vite dev server proxies /api to the backend
#   * the deployed website — the server serves this build from the same
#     origin, so a relative /api is correct and nothing needs configuring
#
# Set it to an absolute URL only for:
#   * phone testing over Wi-Fi, e.g. http://192.168.1.5:5000
#   * the Android APK, which has no dev server to proxy through and must be
#     told where the backend lives, e.g. https://madad.onrender.com
VITE_API_URL=

# Extra addresses for the same backend, comma separated. The app probes all of
# them and uses whichever answers — so an APK can be built once and work over
# both the USB tunnel and Wi-Fi.
VITE_API_FALLBACKS=

# Where `npm run dev` proxies /api and /socket.io during development.
VITE_DEV_PROXY=http://localhost:5000

# Development-only testing tools (a hidden account switcher and a guided
# walkthrough). OFF unless explicitly set to `true`, and stripped from the
# bundle entirely when it is not — scripts/check-bundle.mjs asserts that.
# Never set this for a public deployment.
VITE_DEMO_TOOLS=
