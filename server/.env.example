# ---- Server ----
PORT=5000
NODE_ENV=development

# MongoDB. Local for development; the Atlas URI when deploying.
MONGO_URI=mongodb://127.0.0.1:27017/madad

# JWT.
#
# The server REFUSES TO START in production while this is still the example
# value — anyone who has read this repository could otherwise forge a login
# token for any account. Generate a real one with:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=madad_dev_secret_change_me_in_production
JWT_EXPIRES_IN=30d

# Client origin(s) allowed by CORS, comma separated.
#
# In the production deployment the server serves the React build itself, so
# the app is same-origin and this is not consulted for the website at all.
# It matters for the Android app, which runs at capacitor://localhost.
CLIENT_ORIGIN=http://localhost:5173,http://localhost,capacitor://localhost

# ---- Admin access ----
# Accounts that become admins automatically. Comma separated, case-insensitive.
# Applied when the account registers AND on every login, so adding an address
# here promotes an account that already exists.
# Without this, the admin dashboard is unreachable without editing the database.
ADMIN_EMAILS=

# ---- Demo / seed ----
# Centre point used for demo tasks, and where a new account starts before its
# first GPS fix.
#   npm run move-demo -- Kharghar
SEED_CENTER_LAT=18.9894
SEED_CENTER_LNG=73.1175
SEED_CITY=Panvel

# Mock OTP used by the phone login flow in development.
#
# Development only. The server refuses to return a code in the response body
# when NODE_ENV=production, because on a public URL anyone who knows a phone
# number could otherwise sign in as that account. Real phone login needs an
# SMS provider.
MOCK_OTP=123456

# ---- Bounty rules ----
MIN_BOUNTY=10
MAX_BOUNTY=500

# ---- Trust engine ----
TRUST_STARTING_SCORE=70
TRUST_RESTRICT_BELOW=40

# ---- Voice (Sarvam AI) ----
# Leave SARVAM_API_KEY blank to use the browser Web Speech API fallback.
SARVAM_API_KEY=
SARVAM_API_URL=https://api.sarvam.ai/speech-to-text

# ---- Web Push ----
# Free, no account needed. Generate a key pair once with:
#   npx web-push generate-vapid-keys
# Leave blank and notifications stay in-app only (no push when the app is shut).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@madad.local

# ---- Place names ----
# Reverse geocoding uses OpenStreetMap's Nominatim: free, no key, rate-limited
# to one request a second (the code caches and paces itself accordingly).
# Set to `off` to skip place-name lookups entirely.
PLACE_NAMES=on
